{
  "name": "@anonyjcy/dsh-j-space",
  "version": "1.1.1",
  "description": "J-Space Cognition Suite SV1 native Agent Preset and standalone plugin for DeepSeek Harness",
  "author": "anonyjcy",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "dsh-j-space": "bin/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonyJcy/dsh-j-space.git"
  },
  "bugs": {
    "url": "https://github.com/AnonyJcy/dsh-j-space/issues"
  },
  "homepage": "https://github.com/AnonyJcy/dsh-j-space#readme",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./installer": {
      "types": "./src/installer.ts",
      "default": "./src/installer.ts"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "src",
    "bin",
    "preset",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "j-space",
    "agent",
    "preset",
    "cognition",
    "reasoning",
    "cordis-plugin"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=3.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "typescript": "^5.8.0",
    "vitest": "^4.1.0"
  },
  "scripts": {
    "test": "vitest run",
    "status": "node bin/cli.js status",
    "install:preset": "node bin/cli.js install",
    "uninstall:preset": "node bin/cli.js uninstall",
    "verify": "node bin/cli.js verify"
  }
}
